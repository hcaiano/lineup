    <item>
      <title>Lineup 2.1.0</title>
      <link>https://lineup.caiano.com/</link>
      <sparkle:version>22</sparkle:version>
      <sparkle:shortVersionString>2.1.0</sparkle:shortVersionString>
      <sparkle:releaseNotesLink>https://lineup.caiano.com/release-notes/2.1.0</sparkle:releaseNotesLink>
      <description><![CDATA[
        <h2>Lineup 2.1.0</h2>
        <p>Adds World Clock, an optional tool with its own menu-bar panel. Enable it in Settings to
        search cities and time zones offline, compare their hours, and pin one place's live time
        in the menu bar.</p>
        <p>Scroll up to 24 hours backwards or forwards, or enter an exact local time. Local stays
        among the other clocks in chronological order. Reopening returns to Now, and the pinned
        menu-bar time always stays live.</p>
        <p>Cities include estimates for the next sunrise or sunset. All clocks follow your Mac's
        12- or 24-hour format. No location permission or network connection is required.</p>
      ]]></description>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <pubDate>Tue, 29 Sep 2026 14:59:26 +0000</pubDate>
      <enclosure url="https://lineup.caiano.com/downloads/Lineup-2.1.0.dmg" type="application/octet-stream" sparkle:edSignature="YKN7+Fp3h6t1wXcvNMFTumi7TrwV4iVvM9wDxGOfB2MKfc2q/JSMF5W1c8V5sLnqeuZwYOJYK+i7L1BEPa3PCg==" length="6795635" />
